# Copie para .streamlit/secrets.toml e preencha. O secrets.toml nunca vai para o GitHub.
# Valores do Auth0: Applications → Vigoria → Settings (ver docs/GUIA_AUTH0.md)

[auth]
# Diferente em cada sítio onde a app corre (e tem de estar nas Allowed Callback URLs e nas
# Allowed Logout URLs do Auth0):
#   local:                    http://localhost:8501/oauth2callback
#   Streamlit Community Cloud: https://<nome>.streamlit.app/oauth2callback
#   Railway (Fase 10):         https://<app>.up.railway.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Texto aleatório longo, um por ambiente. Gerar no PowerShell:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""

[auth.auth0]
client_id = ""
client_secret = ""
# Substituir {tenant} pelo nome do tenant (o «Domain» do Auth0 é {tenant}.eu.auth0.com)
server_metadata_url = "https://{tenant}.eu.auth0.com/.well-known/openid-configuration"
# Obriga a escolher a conta em cada entrada (importante em computadores partilhados)
client_kwargs = { "prompt" = "login" }

# Aplicação Machine to Machine, só com a permissão delete:users: apaga a conta de entrada
# quando a pessoa apaga a conta na Vigoria (docs/GUIA_AUTH0.md, secção 8). Sem esta secção,
# a app apaga os dados e regista o identificador da conta para apagar à mão.
[auth0_gestao]
client_id = ""
client_secret = ""
