# Copie para .streamlit/secrets.toml e preencha. O secrets.toml nunca vai para o GitHub.
# Valores do Auth0: Applications → Vigoria → Settings (ver docs/GUIA_AUTH0.md)

[auth]
# Em produção, trocar pelo endereço público: https://<app>.up.railway.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Texto aleatório longo. Gerar no PowerShell:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""

[auth.auth0]
client_id = ""
client_secret = ""
# Substituir <dominio> pelo "Domain" do Auth0, por exemplo vigoria.eu.auth0.com
server_metadata_url = "https://<dominio>/.well-known/openid-configuration"
# Obriga a escolher a conta em cada entrada (importante em computadores partilhados)
client_kwargs = { "prompt" = "login" }
