# Variáveis para provar a imagem em local (docker run --env-file .env.docker).
# Copie para .env.docker na raiz do projeto (fica fora do Git) e preencha.
# Formato do --env-file: NOME=valor, sem aspas e sem espaços à volta do «=».
# No Railway estas variáveis criam-se no painel do serviço (docs/GUIA_PRODUCAO.md).

AMBIENTE=local
# SQLite dentro do contentor (perde-se ao parar; serve para a prova de fumo)
DATABASE_URL=sqlite:////tmp/vigoria.db
APP_URL=http://localhost:8080
VIGORIA_PROVEDOR_LLM=simulado

# Auth0 de DESENVOLVIMENTO. Acrescente http://localhost:8080/oauth2callback às Allowed
# Callback URLs e Allowed Logout URLs, e http://localhost:8080 às Allowed Web Origins.
AUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
AUTH_COOKIE_SECRET=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SERVER_METADATA_URL=
# Opcional (as duas ou nenhuma): aplicação Machine to Machine para apagar contas
AUTH0_GESTAO_CLIENT_ID=
AUTH0_GESTAO_CLIENT_SECRET=
