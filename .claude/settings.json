      "Bash(git branch *)",
      "PowerShell(pytest *)",
      "PowerShell(ruff *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
