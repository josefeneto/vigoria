# Copie este ficheiro para .env e preencha os valores. O .env nunca vai para o GitHub.

# Fornecedor de LLM: gemini | groq | mistral. A reserva (opcional, diferente do principal) só é
# usada quando o principal falha de vez: 503/504 depois das repetições, tempo máximo
# (120 s) excedido, quota diária esgotada ou pedido demasiado grande (413); e, na
# verificação, para a terceira chamada, se a regeneração do principal também falhar.
# «simulado» (só com AMBIENTE=local, sem reserva): devolve sempre o plano guardado da
# persona de teste, sem chamar nenhuma LLM — para testar a interface sem gastar quota.
VIGORIA_PROVEDOR_LLM=gemini
VIGORIA_PROVEDOR_RESERVA=groq

# Gemini — chave criada em https://aistudio.google.com
GEMINI_API_KEY=
# Confirmar no AI Studio o modelo Flash disponível no momento (a família 2.5 foi descontinuada a 16/10/2026)
GEMINI_MODEL=gemini-flash-latest

# Groq — https://console.groq.com. Modelo com saída JSON estruturada (modo estrito),
# por exemplo openai/gpt-oss-120b. No plano gratuito, o limite de 8000 tokens por minuto
# é menor do que um pedido de plano: serve para --testar-ligacao, não para gerar planos.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mistral — https://console.mistral.ai. Endereço europeu (api.eu.mistral.ai: dados na UE/EFTA).
# No plano gratuito, confirmar na consola se os pedidos podem ser usados para treino;
# até lá, só personas fictícias.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Base de dados: SQLite em local; no Railway é preenchida automaticamente com PostgreSQL
DATABASE_URL=sqlite:///vigoria_local.db

# Email (fase 8) — https://www.brevo.com
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_NOME_REMETENTE=Vigoria

# URL pública da app (para ligações nos emails)
APP_URL=http://localhost:8501

# Ambiente: local | demo (Streamlit Community Cloud, só dados fictícios) | producao
AMBIENTE=local
