# Copie este ficheiro para .env e preencha os valores. O .env nunca vai para o GitHub.

# Fornecedor de LLM: gemini | groq | mistral. A reserva (opcional, diferente do principal) só é
# usada quando o principal falha de vez: 503/504 depois das repetições, tempo máximo
# (120 s) excedido, quota diária esgotada ou pedido demasiado grande (413); e, na
# verificação, para a terceira chamada, se a regeneração do principal também falhar.
# «simulado» (só com AMBIENTE=local, sem reserva): devolve sempre o plano guardado da
# persona de teste, sem chamar nenhuma LLM — para testar a interface sem gastar quota.
VIGORIA_PROVEDOR_LLM=gemini
VIGORIA_PROVEDOR_RESERVA=groq
# Modelo da reserva, se for diferente do <NOME>_MODEL dela. Permite a reserva com o mesmo
# fornecedor e outro modelo (por exemplo, groq com outro gpt-oss). Não se usa em produção:
# lá, o principal é o Gemini pago e a reserva o Groq (docs/GUIA_PRODUCAO.md, passo 2).
# Vazio: o <NOME>_MODEL da reserva.
VIGORIA_MODELO_RESERVA=
# Com AMBIENTE=producao, o Gemini (principal ou reserva) é recusado no arranque: o nível
# gratuito não pode servir utilizadores do EEE. Só com o nível pago (projeto
# «vigoria-producao», com faturação; a chave gratuita fica para local e demo):
# VIGORIA_GEMINI_PAGO=true
# VIGORIA_GEMINI_PAGO=false

# Gemini — chave criada em https://aistudio.google.com
GEMINI_API_KEY=
# Confirmar no AI Studio o modelo Flash disponível no momento (a família 2.5 foi descontinuada a 16/10/2026)
GEMINI_MODEL=gemini-flash-latest

# Groq — https://console.groq.com. Modelo com saída JSON estruturada (modo estrito),
# por exemplo openai/gpt-oss-120b. No plano gratuito (8000 tokens por minuto), só passa cerca
# de uma chamada por minuto (cada uma gasta ~7000): serve para testes, não para produção.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Esforço de raciocínio (gpt-oss): low | medium | high. Vazio: o do Groq (medium).
# «low» gasta menos tokens de saída; medir a qualidade antes de o usar por omissão.
GROQ_REASONING_EFFORT=

# Mistral — https://console.mistral.ai. Endereço europeu (api.eu.mistral.ai: dados na UE/EFTA).
# No plano gratuito, confirmar na consola se os pedidos podem ser usados para treino;
# até lá, só personas fictícias.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Base de dados: SQLite em local. PostgreSQL do Neon (Frankfurt), por exemplo:
#   postgresql://<utilizador>:<palavra-passe>@ep-....eu-central-1.aws.neon.tech/vigoria?sslmode=require
# (ver docs/GUIA_AUTH0.md, secção 9). As tabelas criam-se no arranque (Alembic).
DATABASE_URL=sqlite:///vigoria_local.db

# Só para testes (AMBIENTE=local): entrar como utilizador fictício, sem Auth0. Nunca em produção.
# VIGORIA_UTILIZADOR_LOCAL=1

# Planos que cada pessoa pode pedir por dia (dia de Lisboa; conta também as gerações que
# falham). 0 = sem limite.
VIGORIA_PLANOS_POR_DIA=3

# Fase de testes só por convite: emails separados por vírgulas. Vazio = todos podem entrar.
# No Cloud, nos Secrets (chave de topo, acima de [auth]): VIGORIA_EMAILS_PERMITIDOS = "a@x.pt, b@y.pt"
VIGORIA_EMAILS_PERMITIDOS=

# Lembretes por email (Fase 8) — https://www.brevo.com (Configurações → SMTP e API → Chaves API).
# Só a tarefa dos lembretes precisa da chave (produção: serviço cron do Railway; demo: GitHub
# Actions, só manual); a app não envia emails.
BREVO_API_KEY=
EMAIL_REMETENTE=geral@vigoria.pt
EMAIL_NOME_REMETENTE=Vigoria

# Assina as ligações «Deixar de receber lembretes»: pelo menos 32 caracteres, o mesmo valor na
# app (Secrets do Cloud) e no GitHub. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VIGORIA_SEGREDO_LEMBRETES=

# URL pública da app (para ligações nos emails)
APP_URL=http://localhost:8501

# Ambiente: local | demo (Streamlit Community Cloud, só dados fictícios) | producao
AMBIENTE=local
